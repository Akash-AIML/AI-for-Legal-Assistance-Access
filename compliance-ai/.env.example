# OpenAI-compatible provider (Groq API for ultra-fast LPU inference).
# Leave OPENAI_API_KEY or GROQ_API_KEY empty for offline demo mode.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_CHAT_MODEL=openai/gpt-oss-120b
OPENAI_EMBED_MODEL=text-embedding-3-small

# Persistence
CHROMA_DIR=./backend/data/chroma
DB_PATH=./backend/data/sessions.db

# Retrieval tuning
DENSE_K=10
BM25_K=10
FINAL_K=5

# Security
JWT_SECRET=compliance-ai-secret-key-production-change-me-32b

# Optional local cross-encoder reranker (heavy; OFF by default)
LOCAL_RERANKER=false