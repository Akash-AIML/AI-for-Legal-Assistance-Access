# OpenAI-compatible provider. Leave OPENAI_API_KEY empty for offline demo.
# Point OPENAI_BASE_URL at any OpenAI-compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Persistence
CHROMA_DIR=./backend/data/chroma
DB_PATH=./backend/data/sessions.db

# Retrieval tuning
DENSE_K=10
BM25_K=10
FINAL_K=5

# Security
JWT_SECRET=change-me-in-prod

# Optional local cross-encoder reranker (heavy; OFF by default)
LOCAL_RERANKER=false