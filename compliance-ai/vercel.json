{
  "framework": "vite",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": "(?i).*text/markdown.*" }],
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "header", "key": "accept", "value": "(?i).*text/markdown.*" }],
      "destination": "/api/index.py"
    },
    {
      "source": "/(about|contact|privacy|docs)",
      "destination": "/$1.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    }
  ]
}
