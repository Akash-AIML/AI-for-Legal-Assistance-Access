{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["backend/**"]
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/(favicon\\.svg|icons\\.svg|sitemap\\.xml|llms\\.txt|robots\\.txt|manifest\\.json)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/.well-known/(.*)",
      "dest": "/frontend/.well-known/$1"
    },
    {
      "src": "/(about|contact|privacy|docs)\\.html",
      "dest": "/frontend/$1.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
