{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/api/markdown.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(?!markdown)(.*)",
      "dest": "backend/api/index.py"
    },
    {
      "src": "/(about|contact|privacy|docs)",
      "dest": "/frontend/$1.html"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "header", "key": "accept", "value": "(?i).*text/markdown.*" }],
      "dest": "/frontend/api/markdown.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    }
  ]
}
