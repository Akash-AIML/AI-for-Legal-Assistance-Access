{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(about|contact|privacy|docs)",
      "destination": "/$1.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "header", "key": "accept", "value": "(?i).*text/markdown.*" }],
      "destination": "/api/markdown"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Vary", "value": "Accept" }
      ]
    }
  ]
}
